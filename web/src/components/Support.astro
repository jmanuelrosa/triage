---
const sponsorsUrl = "https://github.com/sponsors/jmanuelrosa";
---

<section id="sponsor" class="relative border-t border-[color:var(--color-line)]">
  <div class="mx-auto max-w-5xl px-6 py-20 sm:py-24">
    <div class="grid gap-10 md:grid-cols-[1fr_auto] md:items-center">
      <div class="max-w-2xl">
        <p class="text-xs uppercase tracking-widest text-[color:var(--color-accent-3)]">Support</p>
        <h2 class="mt-3 text-3xl font-semibold tracking-tight sm:text-4xl">
          Keep Triage free and independent.
        </h2>
        <p class="mt-4 text-[color:var(--color-fg-soft)]">
          Triage is built by one person on the side. Sponsoring me on GitHub keeps it
          ad-free, funds bug fixes and new features, and supports the next macOS apps
          I'm working on. Any tier helps — personal sponsorships pass 100% through,
          no GitHub fees.
        </p>
      </div>

      <a
        rel="noopener"
        href={sponsorsUrl}
        data-umami-event="sponsor-cta"
        class="inline-flex items-center justify-center gap-2 self-start rounded-lg border border-[color:var(--color-accent-3)]/50 bg-[color:var(--color-bg-soft)] px-5 py-3 text-sm font-medium text-[color:var(--color-fg)] shadow-lg shadow-black/30 transition hover:border-[color:var(--color-accent-3)] hover:bg-[color:var(--color-bg)] md:self-center"
      >
        <svg viewBox="0 0 16 16" class="h-4 w-4 text-[color:var(--color-accent-3)]" fill="currentColor" aria-hidden="true">
          <path d="m8 14.25.345.666a.75.75 0 0 1-.69 0l-.008-.004-.018-.01a7.152 7.152 0 0 1-.31-.17 22.055 22.055 0 0 1-3.434-2.414C2.045 10.731 0 8.35 0 5.5 0 2.836 2.086 1 4.25 1 5.797 1 7.153 1.802 8 3.02 8.847 1.802 10.203 1 11.75 1 13.914 1 16 2.836 16 5.5c0 2.85-2.045 5.231-3.885 6.818a22.066 22.066 0 0 1-3.744 2.584l-.018.01-.006.003h-.002Z" />
        </svg>
        Sponsor on GitHub
      </a>
    </div>
  </div>
</section>
